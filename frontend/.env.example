# Frontend environment variables (copy to frontend/.env.local)
# Leave both Supabase values EMPTY to use local demo mode (Flask signs you in; no Supabase needed).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=/api

# DEV ONLY — bypasses all authentication. NEVER set true outside local dev.
VITE_DEV_BYPASS_AUTH=false
