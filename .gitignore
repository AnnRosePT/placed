# PlacementAI — .gitignore

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── Environment secrets ───────────────────────────────────────
.env*
!.env.example

# ── ML Artifacts (large binaries — exclude from git) ─────────
backend/ml/artifacts/**/*.joblib
backend/ml/artifacts/*.pkl
backend/ml/artifacts/*.bin

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/

# ── Database ──────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Test artifacts ────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ── Local demo data store ─────────────────────────────────────
backend/instance/
